<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <EffecterDef>
        <defName>Dazzled_Effect</defName>
        <children>
            <li>
                <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
                <scale>0.1~0.3</scale>
                <ticksBetweenMotes>30</ticksBetweenMotes>
                <speed>0</speed>
                <angle>0~2</angle>
                <rotation>0~45</rotation>
                <rotationRate>0.3</rotationRate>
                <positionRadius>0.4</positionRadius>
                <burstCount>1</burstCount>
                <moteDef>DV_Mote_DazzleSpark</moteDef>
                <attachToSpawnThing>true</attachToSpawnThing>
                <absoluteAngle>True</absoluteAngle>
                <fleckUsesAngleForVelocity>false</fleckUsesAngleForVelocity>
                <spawnLocType>OnTarget</spawnLocType>
            </li>
            <li>
                <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
                <scale>0.4~0.6</scale>
                <ticksBetweenMotes>20</ticksBetweenMotes>
                <speed>0</speed>
                <angle>0~2</angle>
                <rotation>0~45</rotation>
                <rotationRate>0.3</rotationRate>
                <positionRadius>0.4</positionRadius>
                <burstCount>1</burstCount>
                <moteDef>DV_Mote_DazzleShine</moteDef>
                <attachToSpawnThing>true</attachToSpawnThing>
                <absoluteAngle>True</absoluteAngle>
                <fleckUsesAngleForVelocity>false</fleckUsesAngleForVelocity>
                <spawnLocType>OnTarget</spawnLocType>
            </li>
        </children>
    </EffecterDef>

    <ThingDef ParentName="MoteBase">
        <defName>DV_Mote_DazzleSpark</defName>
        <graphicData>
            <texPath>Mote/StunParticle</texPath>
            <shaderType>TransparentPostLight</shaderType>
        </graphicData>
        <thingClass>MoteThrownAttached</thingClass>
        <altitudeLayer>MoteOverhead</altitudeLayer>
        <mote>
            <fadeInTime>0.2</fadeInTime>
            <solidTime>0.4</solidTime>
            <fadeOutTime>0.2</fadeOutTime>
            <growthRate>0.2</growthRate>
        </mote>
    </ThingDef>

    <ThingDef ParentName="MoteBase">
        <defName>DV_Mote_DazzleShine</defName>
        <graphicData>
            <texPath>Mote/ShineParticle</texPath>
            <shaderType>TransparentPostLight</shaderType>
            <color>(255, 255, 255, 140)</color>
        </graphicData>
        <thingClass>MoteThrownAttached</thingClass>
        <altitudeLayer>MoteOverhead</altitudeLayer>
        <mote>
            <fadeInTime>0.1</fadeInTime>
            <solidTime>0.05</solidTime>
            <fadeOutTime>0.2</fadeOutTime>
            <growthRate>0.8</growthRate>
        </mote>
    </ThingDef>

</Defs>
 