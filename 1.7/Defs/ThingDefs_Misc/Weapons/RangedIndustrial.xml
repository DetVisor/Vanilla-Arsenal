  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>DV_Gun_ThermoRifle</defName>
    <label>thermorifle</label>
    <description>A heavy duty sniper rifle loaded with thermobaric ammunition. A large powered scope hones in on possible targets allowing for better precision. The high-caliber cartridges disperse flammable aerosolized gas upon impact which explodes causing intense pressure waves and subsequently rarefaction. Thermobaric weapons are considered the best option against mechanoids, and were widely employed during the mechanoid wars.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/Thermorifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
    </graphicData>
    <equippedDistanceOffset>0.2</equippedDistanceOffset>
    <equippedAngleOffset>45</equippedAngleOffset>
